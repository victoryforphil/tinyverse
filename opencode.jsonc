{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-pty"],
  "agent": {
    "general": {
      "model": "openrouter/z-ai/glm-4.7-flash"
    },
    "explore": {
      "model": "openrouter/x-ai/grok-4.1-fast",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "external_directory": {
          "/Users/alex/repos/vfp/tinyverse": "allow",
          "/Users/alex/repos/vfp/tinyverse/**": "allow",
          "/Users/alex/repos/vfp/dark-factory": "allow",
          "/Users/alex/repos/vfp/dark-factory/**": "allow"
        }
      }
    },
    "compaction": {
      "model": "openrouter/google/gemini-3-flash-preview"
    },
    "title": {
      "model": "openrouter/x-ai/grok-4.1-fast"
    },
    "summary": {
      "model": "openrouter/x-ai/grok-4.1-fast"
    }
  },
  "mcp": {
    "perplexity": {
      "type": "local",
      "command": ["npx", "-y", "@perplexity-ai/mcp-server"],
      "enabled": true,
      "environment": {
        "PERPLEXITY_API_KEY": "{env:PERPEXTITY_API_KEY}",
      },
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}",
      },
      "oauth": false,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
      },
      "oauth": false,
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false,
    },
  },
}
